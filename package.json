{
  "name": "knead",
  "version": "0.3.5",
  "description": "Playsound generator for Minecraft",
  "author": "NeAc",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "cross-env NODE_ENV=\"development\" webpack serve --config webpack.config.mts --mode development",
    "build": "cross-env NODE_ENV=\"production\" webpack --config webpack.config.mts --progress",
    "package": "tauri build",
    "package:win": "tauri build --bundles nsis",
    "package:win:portable": "tauri build --no-bundle --config src-tauri/tauri.portable.conf.json",
    "package:mac": "tauri build --bundles dmg",
    "package:linux": "tauri build --bundles appimage",
    "tauri": "tauri",
    "tcm": "tcm src",
    "lint": "eslint src/** --no-error-on-unmatched-pattern --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:studio": "playwright test",
    "selfcheck": "tsx -e \"require('./src/web/Sub/utils/tickPixel')._selfCheckTickPixel(); require('./src/web/Sub/utils/timelineIO')._selfCheckTimelineIO(); require('./src/web/Sub/utils/curvePresets')._selfCheckCurvePresets(); require('./src/web/Sub/utils/curveScaling')._selfCheckCurveScaling(); require('./src/web/Sub/utils/curveHandles')._selfCheckCurveHandles(); require('./src/web/Sub/utils/projectFiles')._selfCheckProjectFiles()\""
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.30.6",
    "@eslint/js": "^10.0.1",
    "@nbsjs/core": "6.1.0",
    "@playwright/test": "^1.65.1",
    "@reduxjs/toolkit": "^2.15.0",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@tauri-apps/cli": "^2.12.6",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.4",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/webaudioapi": "^0.0.27",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.5",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "html-webpack-plugin": "^5.6.8",
    "jsdom": "^31.0.1",
    "mini-css-extract-plugin": "^2.10.2",
    "react-icons": "^5.7.0",
    "react-redux": "^9.3.1",
    "react-router": "^8.5.3",
    "ts-loader": "^9.6.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2",
    "webpack": "^5.113.0",
    "webpack-cli": "^7.3.1",
    "webpack-dev-server": "^6.1.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@yamada-ui/react": "^2.3.4",
    "i18next": "^27.2.9",
    "immer": "^11.2.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "react-select": "^5.10.2",
    "react-window": "^2.5.4",
    "uuid": "^14.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
